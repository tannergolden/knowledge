#!/bin/sh
# BRAIN commit-msg guard: enforce the AI-Driven Commit Process (Conventional
# Commits) on every commit to this vault. Wired by `brain.command install-hooks`
# (core.hooksPath). The header must be `<type>(<scope>): <emoji> <summary>`, a
# valid type, one emoji, 72 chars or fewer. Bypass a one-off with
# `git commit --no-verify`.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
engine="$root/System/brain.command"
[ -f "$engine" ] || exit 0

if ! python3 "$engine" commitcheck "$1"; then
    echo ""
    echo "  Commit rejected by the BRAIN commit-msg guard. Fix the header above."
    exit 1
fi
exit 0
