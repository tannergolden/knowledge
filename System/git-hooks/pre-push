#!/bin/sh
# BRAIN pre-push guard: block a push that would ship a secret or structured PII.
#
# This hook is tracked with the vault (portable), but git only fires it once this
# clone points core.hooksPath at System/git-hooks. Wire it with:
#     python3 System/brain.command install-hooks
# Re-run that after every fresh clone.
#
# It runs the engine's secret scan over all tracked text and blocks on any finding.
# A genuine false positive: add the inline marker `brain-allow-secret` to the line,
# or, in a real emergency, bypass with `git push --no-verify`.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
engine="$root/System/brain.command"
[ -f "$engine" ] || exit 0

if ! python3 "$engine" secrets --quiet; then
    echo ""
    echo "  Push aborted by the BRAIN secret/PII guard. See the findings above."
    exit 1
fi
exit 0
